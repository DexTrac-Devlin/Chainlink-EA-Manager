#!/bin/bash

# ea-name: static-market-hours-redis
# endpoint: http://192.168.2.122:2122

source api_keys
source misc_vars

docker run \
 --name static-market-hours-redis \
 --restart=unless-stopped \
 --net eas-net \
 --link redis-cache \
 --ip 192.168.2.122 \
 -p 2122:2122 \
 -e EA_PORT=2122 \
 -e TIMEOUT=60000 \
 -e CME_TRSY_REGULAR_SCHEDULE="$CME_TRSY_REGULAR_SCHEDULE" \
 -e CBOT_AG_REGULAR_SCHEDULE="$CBOT_AG_REGULAR_SCHEDULE" \
 -e CME_CATTLE_REGULAR_SCHEDULE="$CME_CATTLE_REGULAR_SCHEDULE" \
 -e CME_EQUITY_INDEX_REGULAR_SCHEDULE="$CME_EQUITY_INDEX_REGULAR_SCHEDULE" \
 -e COMEX_GOLD_REGULAR_SCHEDULE="$COMEX_GOLD_REGULAR_SCHEDULE" \
 -e COMEX_SILVER_REGULAR_SCHEDULE="$COMEX_SILVER_REGULAR_SCHEDULE" \
 -e COMEX_COPPER_REGULAR_SCHEDULE="$COMEX_COPPER_REGULAR_SCHEDULE" \
 -e NYMEX_BRENT_REGULAR_SCHEDULE="$NYMEX_BRENT_REGULAR_SCHEDULE" \
 -e NYMEX_HHNG_REGULAR_SCHEDULE="$NYMEX_HHNG_REGULAR_SCHEDULE" \
 -e NYMEX_PLT_REGULAR_SCHEDULE="$NYMEX_PLT_REGULAR_SCHEDULE" \
 -e NYMEX_PLD_REGULAR_SCHEDULE="$NYMEX_PLD_REGULAR_SCHEDULE" \
 -e NYMEX_GASOIL_REGULAR_SCHEDULE="$NYMEX_GASOIL_REGULAR_SCHEDULE" \
 -e NYMEX_COFFEE_REGULAR_SCHEDULE="$NYMEX_COFFEE_REGULAR_SCHEDULE" \
 -e NYMEX_SUGAR_REGULAR_SCHEDULE="$NYMEX_SUGAR_REGULAR_SCHEDULE" \
 -e NYMEX_COCOA_REGULAR_SCHEDULE="$NYMEX_COCOA_REGULAR_SCHEDULE" \
 -e CACHE_ENABLED=true \
 -e CACHE_TYPE=redis \
 -e CACHE_KEY_GROUP=static-market-hours \
 -e CACHE_KEY_IGNORED_PROPS=meta \
 -e CACHE_REDIS_HOST="192.168.1.1" \
 -e CACHE_REDIS_PORT=6379 \
 -e RATE_LIMIT_ENABLED=true \
 -e WARMUP_ENABLED=true \
 -e REQUEST_COALESCING_ENABLED=true \
 -e REQUEST_COALESCING_INTERVAL=100 \
 -e REQUEST_COALESCING_INTERVAL_MAX=1000 \
 -e REQUEST_COALESCING_INTERVAL_COEFFICIENT=2 \
 -e REQUEST_COALESCING_ENTROPY_MAX=0 \
 -e LOG_LEVEL=info \
 -e DEBUG=false \
 -e API_VERBOSE=false \
 -e EXPERIMENTAL_METRICS_ENABLED=true \
 -e METRICS_NAME=static-market-hours \
 -e RETRY=1 \
 -l prometheus-scrape.enabled=true \
 -l prometheus-scrape.job_name="static-market-hours-redis" \
 -l prometheus-scrape.port=9080 \
 -l prometheus-scrape.metrics_path="/metrics" \
